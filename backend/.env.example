# ==============================================================================
# INVESTMATE Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/investmate
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/investmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/investmate

# JWT Authentication Secrets
JWT_SECRET=investmate_super_secret_jwt_key_2026_rural_financial_awareness
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated or * for development)
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
